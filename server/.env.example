PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/book_exchange
JWT_SECRET=development_super_secret_jwt_key_minimum_32_characters_long_123
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# SMTP Email Delivery (optional in development; when empty, emails are logged to console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@bookexchange.campus

# Google OAuth 2.0 (optional in development; required for live Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
