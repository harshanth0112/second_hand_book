PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# For production (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campusbooks?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/book_exchange
# Generate a secure key in production with: openssl rand -hex 32 (min 32 characters)
JWT_SECRET=development_super_secret_jwt_key_minimum_32_characters_long_123
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# Sendliberty Email Delivery
SENDLIBERTY_API_KEY=

# Google OAuth 2.0 (optional in development; required for live Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary image hosting (optional in dev, recommended for production image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin & Background Jobs
ADMIN_EMAIL=admin@college.edu
# In production, ADMIN_PASSWORD is required and must NOT be left to default Admin1234!
ADMIN_PASSWORD=your_strong_admin_password_here
JOBS_ENABLED=false
